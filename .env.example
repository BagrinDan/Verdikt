CODEQL_WORKSPACE_DIR=./codeql/workspace
CODEQL_RESULTS_DIR=./codeql/results
CODEQL_CONTAINER_NAME=verdikt-codeql

# Execution mode for code. 
# If u want to run it localy put execution mode local
# Else put docker. 
# Why? Because the logic of code local and docker are little bit different.
# Check app/executor for more intel
CODEQL_EXECUTION_MODE=local 

DEBUG=True

DOCKER_GID=961

